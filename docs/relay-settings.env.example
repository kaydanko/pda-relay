# Phase 1 development only. Keep this listener on loopback; LAN and public/Internet
# deployment are unsupported even when a bind override is technically available.
PDA_RELAY_LISTEN=127.0.0.1:8080

# Resource limits. Benchmark before changing them.
PDA_RELAY_MAX_CONNECTIONS=32
PDA_RELAY_MAX_FRAME_BYTES=16384
PDA_RELAY_MAX_PAYLOAD_BYTES=16000
PDA_RELAY_OUTBOUND_QUEUE_MESSAGES=16
PDA_RELAY_PACKETS_PER_SECOND=20

# Session policy, in seconds/count.
PDA_RELAY_HELLO_TIMEOUT_SECONDS=5
PDA_RELAY_HEARTBEAT_INTERVAL_SECONDS=15
PDA_RELAY_HEARTBEAT_TIMEOUT_SECONDS=45
PDA_RELAY_MALFORMED_FRAME_THRESHOLD=3

# Operational metadata only. The code has no payload logging path.
RUST_LOG=pda_relay=info
